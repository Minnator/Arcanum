<UserControl x:Class = "Arcanum.UI.Components.UserControls.ValueAllocators.MassPopPainterView"
             xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc = "http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
             xmlns:acb = "clr-namespace:Arcanum.UI.Components.UserControls.BaseControls.AutoCompleteBox"
             xmlns:g = "clr-namespace:Arcanum.Core.GlobalStates;assembly=Arcanum.Core"
             xmlns:valueAllocators = "clr-namespace:Arcanum.UI.Components.UserControls.ValueAllocators"
             mc:Ignorable = "d" d:DesignHeight = "500" d:DesignWidth = "400"
             d:DataContext = "{d:DesignInstance valueAllocators:MassPopPainterViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source = "/Arcanum_UI;component/Components/Styles/Base/BaseTextBoxStyle.xaml" />
                <ResourceDictionary Source = "/Arcanum_UI;component/Components/Styles/Base/BaseButton.xaml" />
                <ResourceDictionary Source = "/Arcanum_UI;component/Components/Styles/Base/BlueTollgeButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility = "Auto">
        <StackPanel Margin = "10">
            <TextBlock Text = "Mass Pop Painter" Foreground = "{StaticResource GreenColorBrush}" FontWeight = "Bold"
                       HorizontalAlignment = "Center" FontSize = "14" />

            <!-- CULTURE BLOCK -->
            <Border Background = "{StaticResource DarkBackColorBrush}" CornerRadius = "5" Margin = "0, 2"
                    Padding = "10" BorderThickness = "1" BorderBrush = "{StaticResource LightBackColorBrush}">
                <StackPanel>
                    <TextBlock Text = "CULTURE TRANSFORMATION" FontWeight = "SemiBold" FontSize = "11" Opacity = "0.8"
                               Foreground = "{StaticResource BlueAccentColorBrush}" Margin = "0, 0, 0, 4" />

                    <!-- Source & Target -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width = "Auto" /><ColumnDefinition Width = "*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height = "Auto" />
                            <RowDefinition Height = "Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row = "0" Grid.Column = "0" IsChecked = "{Binding FilterByCulture}"
                                  Content = "From:" Width = "60" VerticalAlignment = "Center" />
                        <acb:AutoCompleteComboBox Grid.Row = "0" Grid.Column = "1" Height = "24" Margin = "0, 1"
                                                  IsEnabled = "{Binding FilterByCulture}"
                                                  FullItemsSource = "{Binding AvailableCultures}"
                                                  SelectedItem = "{Binding SourceCulture}" />

                        <TextBlock Grid.Row = "1" Grid.Column = "0" Text = "To:" Width = "60"
                                   VerticalAlignment = "Center" Opacity = "0.7" Margin = "5,0,0,0" />
                        <acb:AutoCompleteComboBox Grid.Row = "1" Grid.Column = "1" Height = "24" Margin = "0, 1"
                                                  FullItemsSource = "{Binding Source={x:Static g:Globals.Cultures}, Path=Values}"
                                                  SelectedItem = "{Binding TargetCulture}" />
                    </Grid>

                    <!-- Slider -->
                    <valueAllocators:LabeledSlider Label = "Transfer %" Margin = "0, 3, 0, 0"
                                                   Value = "{Binding CultureTransferPercent}"
                                                   SliderForeground = "{StaticResource BlueAccentColorBrush}" />
                </StackPanel>
            </Border>

            <!-- RELIGION BLOCK -->
            <Border Background = "{StaticResource DarkBackColorBrush}" CornerRadius = "5" Margin = "0, 2"
                    Padding = "10" BorderThickness = "1" BorderBrush = "{StaticResource LightBackColorBrush}">
                <StackPanel>
                    <TextBlock Text = "RELIGION TRANSFORMATION" FontWeight = "SemiBold" FontSize = "11" Opacity = "0.8"
                               Foreground = "#FFD700" Margin = "0, 0, 0, 4" />

                    <!-- Source & Target -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width = "Auto" /><ColumnDefinition Width = "*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height = "Auto" />
                            <RowDefinition Height = "Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row = "0" Grid.Column = "0" IsChecked = "{Binding FilterByReligion}"
                                  Content = "From:" Width = "60" VerticalAlignment = "Center" />
                        <acb:AutoCompleteComboBox Grid.Row = "0" Grid.Column = "1" Height = "24" Margin = "0, 1"
                                                  IsEnabled = "{Binding FilterByReligion}"
                                                  FullItemsSource = "{Binding AvailableReligions}"
                                                  SelectedItem = "{Binding SourceReligion}" />

                        <TextBlock Grid.Row = "1" Grid.Column = "0" Text = "To:" Width = "60"
                                   VerticalAlignment = "Center" Opacity = "0.7" Margin = "5,0,0,0" />
                        <acb:AutoCompleteComboBox Grid.Row = "1" Grid.Column = "1" Height = "24" Margin = "0, 1"
                                                  FullItemsSource = "{Binding Source={x:Static g:Globals.Religions}, Path=Values}"
                                                  SelectedItem = "{Binding TargetReligion}" />
                    </Grid>

                    <!-- Slider -->
                    <valueAllocators:LabeledSlider Label = "Transfer %" Margin = "0, 3, 0, 0"
                                                   Value = "{Binding ReligionTransferPercent}"
                                                   SliderForeground = "#FFD700" />

                </StackPanel>
            </Border>

            <!-- POP TYPE BLOCK -->
            <Border Background = "{StaticResource DarkBackColorBrush}" CornerRadius = "5" Margin = "0, 2"
                    Padding = "10" BorderThickness = "1" BorderBrush = "{StaticResource LightBackColorBrush}">
                <StackPanel>
                    <TextBlock Text = "POP TYPE TRANSFORMATION" FontWeight = "SemiBold" FontSize = "11" Opacity = "0.8"
                               Foreground = "#E06666" Margin = "0, 0, 0, 4" />

                    <!-- Source & Target -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width = "Auto" /><ColumnDefinition Width = "*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height = "Auto" />
                            <RowDefinition Height = "Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row = "0" Grid.Column = "0" IsChecked = "{Binding FilterByPopType}"
                                  Content = "From:" Width = "60" VerticalAlignment = "Center" />
                        <acb:AutoCompleteComboBox Grid.Row = "0" Grid.Column = "1" Height = "24" Margin = "0, 1"
                                                  IsEnabled = "{Binding FilterByPopType}"
                                                  FullItemsSource = "{Binding AvailablePopTypes}"
                                                  SelectedItem = "{Binding SourcePopType}" />

                        <TextBlock Grid.Row = "1" Grid.Column = "0" Text = "To:" Width = "60"
                                   VerticalAlignment = "Center" Opacity = "0.7" Margin = "5,0,0,0" />
                        <acb:AutoCompleteComboBox Grid.Row = "1" Grid.Column = "1" Height = "24" Margin = "0, 1"
                                                  FullItemsSource = "{Binding Source={x:Static g:Globals.PopTypes}, Path=Values}"
                                                  SelectedItem = "{Binding TargetPopType}" />
                    </Grid>

                    <!-- Slider -->
                    <valueAllocators:LabeledSlider Label = "Transfer %" Margin = "0, 3, 0, 0"
                                                   Value = "{Binding TypeTransferPercent}" SliderForeground = "#E06666" />
                </StackPanel>
            </Border>

            <TextBlock Text = "Settings apply to current selection upon clicking 'Apply Changes'." FontSize = "10"
                       Opacity = "0.4" HorizontalAlignment = "Center" TextAlignment = "Center" Margin = "0,10" />
        </StackPanel>
    </ScrollViewer>
</UserControl>