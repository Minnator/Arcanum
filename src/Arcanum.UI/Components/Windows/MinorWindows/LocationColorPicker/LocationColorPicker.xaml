<styleClasses:BaseWindow x:Class = "Arcanum.UI.Components.Windows.MinorWindows.LocationColorPicker.LocationColorPicker"
                         xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc = "http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:locationColorPicker = "clr-namespace:Arcanum.UI.Components.Windows.MinorWindows.LocationColorPicker"
                         xmlns:styleClasses = "clr-namespace:Arcanum.UI.Components.StyleClasses"
                         xmlns:autoCompleteBox = "clr-namespace:Arcanum.UI.Components.UserControls.BaseControls.AutoCompleteBox"
                         xmlns:g = "clr-namespace:Arcanum.Core.GlobalStates;assembly=Arcanum.Core" mc:Ignorable = "d"
                         Title = "Location Color Picker" Width = "400" WindowStartupLocation = "CenterOwner">
    <d:Window.DataContext>
        <locationColorPicker:LocationColorPickerViewModel />
    </d:Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source = "/Arcanum_UI;component/Assets/ArcanumShared/DefaultPalette.xaml" />
                <ResourceDictionary Source = "/Arcanum_UI;component/Assets/ArcanumShared/DefaultFonts.xaml" />
                <ResourceDictionary Source = "/Arcanum_UI;component/Components/Styles/Base/BaseButton.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key = "ColorPreviewButtonStyle" TargetType = "Button" BasedOn = "{StaticResource {x:Type Button}}">
                <Setter Property = "Template">
                    <Setter.Value>
                        <ControlTemplate TargetType = "Button">
                            <Border x:Name = "border" Background = "{TemplateBinding Background}" BorderBrush = "#444"
                                    BorderThickness = "1" CornerRadius = "3">
                                <ContentPresenter HorizontalAlignment = "Center" VerticalAlignment = "Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property = "IsMouseOver" Value = "True">
                                    <Setter TargetName = "border" Property = "Opacity" Value = "0.8" />
                                </Trigger>
                                <Trigger Property = "IsPressed" Value = "True">
                                    <Setter TargetName = "border" Property = "Opacity" Value = "0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin = "15">
        <Grid.RowDefinitions>
            <RowDefinition Height = "Auto" /> <!-- Previews -->
            <RowDefinition Height = "Auto" /> <!-- Generation Tools -->
            <RowDefinition Height = "*" />    <!-- Selectors -->
            <RowDefinition Height = "Auto" /> <!-- Apply -->
        </Grid.RowDefinitions>

        <!-- 1. Color Preview Section -->
        <StackPanel Grid.Row = "0" Margin = "0,0,0,10">
            <UniformGrid Columns = "2" Margin = "0,0,0,4">
                <TextBlock Text = "Reference" HorizontalAlignment = "Center" FontSize = "11" Opacity = "0.6" />
                <TextBlock Text = "Result" HorizontalAlignment = "Center" FontSize = "11" Opacity = "0.6" />
            </UniformGrid>

            <UniformGrid Columns = "2" Height = "50">
                <Button Style = "{StaticResource ColorPreviewButtonStyle}" Click = "OpenReferencePicker_Click"
                        Margin = "0,0,2,0" Background = "{Binding ReferenceBrush}" />
                <Button Style = "{StaticResource ColorPreviewButtonStyle}" Click = "OpenResultPicker_Click"
                        Margin = "2,0,0,0" Background = "{Binding ColorBrush}" />
            </UniformGrid>

            <!-- Centered Copy Buttons and Mirrored Labels -->
            <Grid Margin = "0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width = "*" /> <!-- Ref Labels -->
                    <ColumnDefinition Width = "Auto" /> <!-- Copy Buttons -->
                    <ColumnDefinition Width = "*" /> <!-- Result Labels -->
                </Grid.ColumnDefinitions>

                <!-- Reference Info (Left) -->
                <StackPanel Grid.Column = "0" VerticalAlignment = "Center" HorizontalAlignment = "Left">
                    <TextBlock Text = "{Binding ReferenceRgbText, StringFormat='RGB: {0}'}" FontSize = "10"
                               Opacity = "0.5" />
                    <TextBlock Text = "{Binding ReferenceHexText, StringFormat='HEX: {0}'}" FontSize = "9"
                               Opacity = "0.4" />
                </StackPanel>

                <!-- Copy Buttons (Center) -->
                <StackPanel Grid.Column = "1" Orientation = "Horizontal" VerticalAlignment = "Center">
                    <styleClasses:BaseButton Content = "RGB" Command = "{Binding CopyRgbCommand}" FontSize = "9"
                                             Padding = "8,2" Margin = "0,0,4,0" VerticalAlignment = "Center" />
                    <styleClasses:BaseButton Content = "HEX" Command = "{Binding CopyHexCommand}" FontSize = "9"
                                             Padding = "8,2" VerticalAlignment = "Center" />
                </StackPanel>

                <!-- Result Info (Right) -->
                <StackPanel Grid.Column = "2" VerticalAlignment = "Center" HorizontalAlignment = "Right">
                    <TextBlock Text = "{Binding RgbText, StringFormat='RGB: {0}'}" FontSize = "11" FontWeight = "Bold"
                               TextAlignment = "Right" />
                    <TextBlock Text = "{Binding HexText, StringFormat='HEX: {0}'}" FontSize = "10" Opacity = "0.5"
                               TextAlignment = "Right" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 2. Generation Tools -->
        <StackPanel Grid.Row = "1" Margin = "0,5,0,15">
            <UniformGrid Columns = "2">
                <styleClasses:BaseButton Content = "Suggest Unused" Command = "{Binding SuggestUnusedCommand}"
                                         Margin = "2" Padding = "4" FontSize = "11" Height = "28" />
                <styleClasses:BaseButton Content = "Suggest Shade" Command = "{Binding CreateShadeCommand}"
                                         Margin = "2" Padding = "4" FontSize = "11" Height = "28" />
            </UniformGrid>
        </StackPanel>

        <!-- 3. Selectors Section -->
        <StackPanel Grid.Row = "2">
            <TextBlock Text = "Target Province:" Margin = "0,0,0,1" FontSize = "10" Opacity = "0.7" />
            <autoCompleteBox:AutoCompleteComboBox Height = "24" Margin = "0,0,0,6"
                                                  FullItemsSource = "{Binding Source={x:Static g:Globals.Provinces}, Path=Values}"
                                                  SelectedItem = "{Binding TargetProvince, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text = "Climate:" Margin = "0,0,0,1" FontSize = "10" Opacity = "0.7" />
            <autoCompleteBox:AutoCompleteComboBox Height = "24" Margin = "0,0,0,6"
                                                  FullItemsSource = "{Binding Source={x:Static g:Globals.Climates}, Path=Values}"
                                                  SelectedItem = "{Binding TargetClimate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text = "Topography:" Margin = "0,0,0,1" FontSize = "10" Opacity = "0.7" />
            <autoCompleteBox:AutoCompleteComboBox Height = "24" Margin = "0,0,0,6"
                                                  FullItemsSource = "{Binding Source={x:Static g:Globals.Topography}, Path=Values}"
                                                  SelectedItem = "{Binding TargetTopography, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- 4. Action Section -->
        <styleClasses:BaseButton Grid.Row = "3" Content = "Apply" Command = "{Binding ConfirmCommand}"
                                 CommandParameter = "{Binding ElementName=ThisWindow}" Height = "35"
                                 Background = "#2E7D32" FontWeight = "Bold" Margin = "0,10,0,0" />
    </Grid>
</styleClasses:BaseWindow>